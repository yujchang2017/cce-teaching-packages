# Google Form 公開填寫網址 (viewform URL,不要尾端 query string)
# 取得方式: Form 編輯頁 → ⋮ → 取得預先填入的連結
NEXT_PUBLIC_FORM_URL=

# Q2「教案編號」entry ID (數字部分,不含 entry. 前綴)
NEXT_PUBLIC_FORM_ENTRY_KEY_ID=

# Q6「提交類型」entry ID
NEXT_PUBLIC_FORM_ENTRY_SUBMIT_TYPE_ID=
# Google Sheets CSV 公開網址（試教/回饋表單統計用）
# 取得方式: Sheets → 檔案 → 共用 → 發布到網路 → 選「表單回覆 1」「逗號分隔 CSV」→ 複製網址
STATS_SHEET_CSV_URL=
# GitHub Discussions 連結 (討論區 fallback)
NEXT_PUBLIC_DISCUSSIONS_URL=https://github.com/yujchang2017/cce-teaching-packages/discussions

# 全站狀態: testing | beta | live
NEXT_PUBLIC_SITE_STATUS=testing
NEXT_PUBLIC_SITE_STATUS_MESSAGE=本網站目前為測試版，資料與流程仍在調整中。

# 本機開發用，讓 dev server 走根路徑
NEXT_PUBLIC_BASE_PATH=/

# 自訂網域 (deploy 時填，本機留空)
CUSTOM_DOMAIN=
