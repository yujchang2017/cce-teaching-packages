{
  // CCE 教材編輯環境：在 GitHub 上一鍵開 Codespaces（雲端 VS Code），
  // 自動裝好 Microsoft 官方「Live Preview」擴充，讓協力者邊改 HTML、邊即時看渲染畫面，
  // 且不會像 WYSIWYG CMS 那樣破壞版面 / SVG / 互動元素。
  "name": "CCE 教材編輯（即時預覽）",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "customizations": {
    "vscode": {
      // 自動安裝「Live Preview」（ms-vscode.live-server）
      "extensions": ["ms-vscode.live-server"],
      "settings": {
        // 用內嵌預覽分頁，方便「左邊程式碼、右邊畫面」並排
        "livePreview.openPreviewTarget": "Embedded Preview"
      }
    }
  },
  // 開好環境後在終端機顯示的小提示
  "postCreateCommand": "echo '✅ 環境就緒：開啟任何教材 .html（例：packages/level-iii/3.1-III/lesson_plan.html），按右上角預覽圖示或右鍵 Show Preview，即可邊改邊看。改完照常 commit、開 PR。'"
}
